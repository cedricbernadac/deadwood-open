    "scope": "Frozen live weapon settings; first unobstructed target, body hit, no armor or upgrades. Damage before clipping to remaining HP, except explicit ordinary Magnum example.",
    "formulas": {
      "legacy": "near until start; linear interpolation from near to far between start and end; far afterward",
      "beyond30m": "when longRangeDamage50 exists, interpolate legacyFalloff(30) to min(legacyFalloff(30), longRangeDamage50/damage) over 30..50m; constant afterward",
      "shotgun": "multiply by 1+(multiplier-1)*(1-t*t*(3-2*t)), t=clamp((distance-fullUntil)/(end-fullUntil),0,1), below boost.end",
      "sniper": "longRangePenetration bypasses falloff; 350 damage until strict maximum range",
      "maximumRange": "bullet contact requires hitAt < weapon.range; zero at and beyond range",
      "penetration": "first target index=0: multiplier 1; no secondary-target damage included",
      "headshots": "excluded; old ordinary bullets used currentWaveBalance headshotMultiplier; Magnum oneShot ignored it",
      "magnum": "ordinary target HP is set to zero; bosses lose fixed 1000 HP; stored weapon.damage=200 was not actual zombie damage",
      "rocket": "distance from explosion center: damage through innerRadius inclusive, linear decrease to zero at radiusDamage; flight distance does not attenuate blast",
      "flamethrower": "direct contact DPS inside cone; separate burnDps and burnDuration not summed into direct DPS",
      "melee": "first target light or heavy damage within selected attack reach; no falloff or subsequent-target retention"
    }
  },
